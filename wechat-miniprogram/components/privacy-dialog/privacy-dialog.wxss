.privacy-shade{position:fixed;inset:0;z-index:1000;background:#16302a88;display:flex;align-items:center;justify-content:center}.privacy-card{box-sizing:border-box;width:88%;max-height:90vh;overflow:auto;padding:34rpx;background:#fbfcf4;border-radius:28rpx;color:#244b4b;box-shadow:0 8rpx 40rpx #16302a33}.privacy-title{font-size:32rpx;font-weight:700;margin-bottom:20rpx}.privacy-body{font-size:25rpx;line-height:1.8;margin-bottom:16rpx}.privacy-link{color:#173d65;text-decoration:underline}.privacy-agree,.privacy-decline{font-size:26rpx;border-radius:20rpx;margin-top:20rpx}.privacy-agree{background:#285f58;color:white}.privacy-decline{background:#e3efdf;color:#244b4b}button::after{border:0}
