.screen{height:100vh;display:flex;flex-direction:column;position:relative}.top{padding:16rpx 28rpx;display:flex;align-items:center;justify-content:space-between;background:#fbfcf4}.mini-brand{display:flex;align-items:center;gap:14rpx}.brand-icon{width:64rpx;height:64rpx;border-radius:18rpx}.brand-name{font-size:29rpx;font-weight:700;color:#173d65}.picker{font-size:24rpx!important;background:#e3efdf!important;padding:0 22rpx!important;height:60rpx;line-height:60rpx!important;border-radius:32rpx;margin:0}.picker::after{border:0}.map-frame{position:relative;flex:1;min-height:0}.canvas{width:100%;height:100%;display:block}.controls{position:absolute;right:24rpx;bottom:140rpx;display:flex;flex-direction:column;gap:16rpx}.controls button{margin:0;width:84rpx;height:84rpx;padding:0;line-height:84rpx;background:#fffef5;border-radius:25rpx;box-shadow:0 4rpx 15rpx #244b4b12;font-size:38rpx}.controls .fit{font-size:24rpx;background:#285f58;color:#fffdec}.controls .info{font-size:24rpx}.bottom{display:flex;align-items:center;justify-content:space-between;padding:12rpx 26rpx calc(14rpx + env(safe-area-inset-bottom));font-size:20rpx;color:#6f8c80}.bottom button{margin:0;padding:0 20rpx;line-height:56rpx;border-radius:24rpx;font-size:22rpx;background:#fbe0cd;color:#a26450}.error{position:absolute;left:30rpx;top:150rpx;background:white;padding:30rpx}.shade{position:fixed;inset:0;background:#16302a66;display:flex;align-items:center;justify-content:center;z-index:10}.sheet{width:88%;height:80%;background:#fbfcf4;border-radius:28rpx;padding:28rpx;display:flex;flex-direction:column;box-sizing:border-box}.sheet-title{font-weight:bold;font-size:32rpx;margin-bottom:20rpx}.source-text{flex:1;min-height:0;font-size:25rpx;line-height:1.75}.sheet button{width:100%;margin-top:20rpx;font-size:28rpx;background:#e3efdf}.search-sheet{height:76%}.search-input{flex:none;height:74rpx;padding:0 20rpx;margin:0 0 14rpx;background:#fff;border:2rpx solid #d7e4d3;border-radius:18rpx;font-size:25rpx}.search-row{height:auto!important;min-height:68rpx;line-height:1.5!important;text-align:left!important;padding:15rpx 18rpx!important;margin:6rpx 0!important;background:#fffef8!important;font-size:24rpx!important}.search-empty{padding:24rpx;color:#71877f;text-align:center}
.route-bar{display:flex;align-items:center;gap:14rpx;padding:12rpx 24rpx;background:#f4f7ec}.route-bar text{flex:1;min-width:0;font-size:22rpx;line-height:1.6}.route-bar button{margin:0;flex-shrink:0;width:auto;height:60rpx;line-height:60rpx;padding:0 16rpx;border-radius:24rpx;font-size:22rpx;background:#e0ecdb}
.food-sheet{background:#f7f0e2}.food-row,.stall-row{width:100%;margin:12rpx 0!important;text-align:left;font-size:24rpx!important;line-height:1.5!important;height:auto!important;min-height:76rpx;padding:18rpx 22rpx!important;background:#fffdf6!important;border-radius:20rpx}.food-tabs{display:flex;gap:12rpx;margin:6rpx 0 16rpx}.food-tab{margin:0!important;flex:1;width:auto!important;height:64rpx!important;line-height:64rpx!important;padding:0 8rpx!important;border-radius:20rpx!important;font-size:23rpx!important;background:#efe3cf!important;color:#7a654f!important}.food-tab.active{background:#285f58!important;color:#fffdf7!important}
.food-summary{padding:20rpx;background:#efe3cf;border-radius:18rpx;font-size:24rpx;line-height:1.7}.food-entry{margin:20rpx 0;padding:22rpx;background:#fffdf6;border-radius:22rpx}.entry-title{font-size:28rpx;font-weight:bold}.entry-note{font-size:22rpx;color:#8e704f;line-height:1.7;margin:10rpx 0}.food-entry text{font-size:24rpx;line-height:1.8}
.food-stall{margin-top:12rpx;padding:8rpx 16rpx;background:#f7f0e2;border-radius:18rpx}.sheet .food-stall-toggle{display:flex;align-items:center;justify-content:space-between;gap:12rpx;width:100%;min-height:70rpx;height:auto;line-height:1.4;margin:0;padding:12rpx 4rpx;background:transparent;text-align:left;border-radius:12rpx}.food-stall-toggle::after{border:0}.food-stall-toggle:active{background:#e7e9d7}.food-entry .food-stall-name{flex:1;min-width:0;font-size:25rpx;font-weight:600;color:#28463d}.food-entry .food-stall-hint{flex-shrink:0;font-size:20rpx;color:#66867a}.food-stall-toggle.expanded .food-stall-hint{color:#285f58}.food-dish{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;padding:10rpx 0;border-top:1rpx solid #e9ddca}.food-dish-name{flex:1;min-width:0}.food-entry .food-dish-price{flex-shrink:0;color:#8e704f;font-size:21rpx}.food-menu-empty{padding:10rpx 4rpx 14rpx;color:#8e704f;font-size:21rpx}
.food-options{margin-top:12rpx;padding-top:12rpx;border-top:1rpx solid #e9ddca;color:#8e704f;line-height:1.6}.food-entry .food-options text{font-size:21rpx}.food-option{display:inline-block;margin-right:12rpx}

.contact-sheet{height:auto;padding:46rpx 28rpx;text-align:center;font-size:28rpx;line-height:1.8}
.contact-note{display:block;margin-top:18rpx;font-size:23rpx;color:#6f8c80;line-height:1.7}
