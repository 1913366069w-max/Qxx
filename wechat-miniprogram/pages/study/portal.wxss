.portal-page{box-sizing:border-box;min-height:100vh;padding:64rpx 36rpx;background:#f4f4e3;color:#244b4b}.portal-logo{display:block;width:110rpx;height:110rpx;margin:0 auto 24rpx}.portal-title{text-align:center;font-size:36rpx;font-weight:700;color:#173d65;margin-bottom:34rpx}.portal-card{background:#fffdf6;border-radius:26rpx;padding:30rpx;line-height:1.8;font-size:26rpx}.portal-description,.portal-url,.portal-success,.portal-error,.portal-note,.portal-steps text{display:block}.portal-url{margin:22rpx 0;padding:22rpx 14rpx;background:#edf3e7;border-radius:16rpx;word-break:break-all;color:#285f58;text-align:center}.portal-copy,.portal-back{font-size:27rpx;border-radius:18rpx}.portal-copy{background:#285f58;color:#fff}.portal-success{margin-top:20rpx;color:#2f7055}.portal-error{margin-top:20rpx;color:#a23f39}.portal-steps{margin-top:28rpx}.portal-steps text+text{margin-top:14rpx}.portal-note{margin-top:24rpx;font-size:23rpx;color:#74877b}.portal-back{margin-top:26rpx;background:#e3efdf;color:#244b4b}button::after{border:0}
